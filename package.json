{
  "name": "epochs",
  "private": true,
  "version": "0.0.1",
  "description": "A free, open, browser-based re-creation of the classic 1996 turn-based civilization-building game, written from a clean-room specification. Codename only; final name to be chosen.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -b packages/formats packages/engine apps/web scripts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "npm run dev --workspace apps/web",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "render-map": "vite-node scripts/render-map.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^26.6.6",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
